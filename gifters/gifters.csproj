<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Rationale: the SDK already includes wwwroot content by default.
         Removing explicit Content include prevents duplicate-item warnings. -->
  </PropertyGroup>

  <!-- Removed explicit <Content Include="wwwroot\**\*"> to avoid duplicate Content items.
       The SDK implicitly includes wwwroot files; keep the project file minimal. -->

</Project>

@page
@model gifters.Pages.Employee.DashboardModel

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container py-5">
    <h1>Employee Dashboard</h1>

    <p class="lead">
        Welcome to the Gifters employee dashboard.
    </p>

    <div class="row mt-4">

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Volunteer Sign-ups</h3>
                    <p>
                        Total: <strong>@Model.VolunteersCount</strong>
                    </p>

                    <a asp-page="/Employee/Volunteers" class="btn btn-sm btn-primary mb-3">View all volunteers</a>

                    <ul class="list-group">
                        @if (Model.RecentVolunteers?.Count > 0)
                        {
                            @foreach (var v in Model.RecentVolunteers)
                            {
                                <li class="list-group-item">
                                    <div class="fw-bold">@v.FullName</div>
                                    <div class="small text-muted">@v.CreatedAt.ToLocalTime().ToString("g")</div>
                                    <div>@v.Skills</div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">No volunteer sign-ups yet.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Donation Summary</h3>
                    <p>
                        Total donations recorded: <strong>@Model.DonationsCount</strong>
                    </p>

                    <a asp-page="/Employee/Donations" class="btn btn-sm btn-primary mb-3">View all donations</a>

                    <ul class="list-group">
                        @if (Model.RecentDonations?.Count > 0)
                        {
                            @foreach (var d in Model.RecentDonations)
                            {
                                <li class="list-group-item">
                                    <div class="fw-bold">@d.Amount @d.Currency</div>
                                    <div class="small text-muted">@d.CreatedAt.ToLocalTime().ToString("g") &mdash; @d.DonationType</div>
                                    @if (d.Anonymous)
                                    {
                                        <div class="text-muted small">Anonymous</div>
                                    }
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">No donations yet.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Relief Project Updates</h3>
                    <p>
                        Current disaster-relief project information will appear here.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Recent Activity</h3>
                    <p>
                        Recent donations and volunteer registrations are shown in the panels above.
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>
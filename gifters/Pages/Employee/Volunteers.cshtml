@page
@model gifters.Pages.Employee.VolunteersModel

@{
    ViewData["Title"] = "Volunteer Registrations";
}

<div class="container py-4">
    <h2>Volunteer Registrations</h2>

    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-info">@msg</div>
    }

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Skills</th>
                <th>Availability</th>
                <th>Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Volunteers.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">No volunteer registrations.</td>
                </tr>
            }
            else
            {
                @foreach (var v in Model.Volunteers)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.FullName</td>
                        <td>@v.Skills</td>
                        <td>@v.Availability</td>
                        <td>@v.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@v.Id" onsubmit="return confirm('Delete registration @v.Id?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <a asp-page="/Employee/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>
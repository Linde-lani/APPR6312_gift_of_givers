@page
@model gifters.Pages.Employee.DonationsModel

@{
    ViewData["Title"] = "Donations";
}

<div class="container py-4">
    <h2>Donations</h2>

    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-info">@msg</div>
    }

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Amount</th>
                <th>Currency</th>
                <th>Type</th>
                <th>Anonymous</th>
                <th>Date</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Donations.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-muted">No donations recorded.</td>
                </tr>
            }
            else
            {
                @foreach (var d in Model.Donations)
                {
                    <tr>
                        <td>@d.Id</td>
                        <td>@d.Amount</td>
                        <td>@d.Currency</td>
                        <td>@d.DonationType</td>
                        <td>@(d.Anonymous ? "Yes" : "No")</td>
                        <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" onsubmit="return confirm('Delete donation @d.Id?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <a asp-page="/Employee/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>
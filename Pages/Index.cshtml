@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="card">
    <div class="hero-overlay">
        <h1>Join the Gifters Community</h1>
        <p>COMMITTED TO HELPING OUR communities FIND CLOSURE</p>
        <div class="cta-buttons">
            <a href="shared/Login" class="cta-button">Login</a>
            <a href="shared/Register" class="cta-button">Register</a>
        </div>
    </div>
</section>


<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h1 class="display-4 fw-bold">Gifters</h1>

            <h2 class="mt-3">
                Helping communities recover after disasters
            </h2>

            <p class="lead mt-3">
                Gifters is a disaster-relief platform that connects people
                who want to help with communities affected by disasters.
            </p>

            <p>
                Through donations and volunteering, individuals can support
                relief projects and help provide assistance to people who
                need it most.
            </p>

            <div class="mt-4">
                <a asp-page="/Shared/Donate" class="btn btn-primary btn-lg me-2">
                    Donate
                </a>

                <a asp-page="/Shared/Volunteer" class="btn btn-outline-primary btn-lg">
                    Volunteer
                </a>

                <a asp-page="/Shared/Report" class="btn btn-outline-primary btn-lg">
                    Report
                </a>
            </div>
        </div>

        <div class="col-md-5 mt-4 mt-md-0">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">How you can help</h3>

                    <p>
                        Every contribution can make a difference.
                        You can support disaster-relief efforts by:
                    </p>

                    <ul>
                        <li>Report incident</li>
                        <li>Making a donation</li>
                        <li>Volunteering your skills</li>
                        <li>Supporting relief projects</li>
                        <li>Helping affected communities recover</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

</div>
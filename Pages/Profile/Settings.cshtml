@page
@model gifters.Pages.Profile.SettingsModel
@{
}

<section class="container my-5">
    <h2 class="fw-bold mb-4 text-primary">Settings</h2>
    <div class="card shadow-sm p-4">
        <h4 class="fw-bold">Account Preferences</h4>
        <hr>
        <form asp-action="UpdateSettings" asp-controller="Profile" method="post">
            <div class="mb-3">
                <label for="Notification" class="form-label">Email Notifications</label>
                <select class="form-select" id="Notification" name="Notification">
                    <option value="Enabled">Enabled</option>
                    <option value="Disabled">Disabled</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="Theme" class="form-label">Theme</label>
                <select class="form-select" id="Theme" name="Theme">
                    <option value="Light">Light</option>
                    <option value="Dark">Dark</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Save Settings</button>
        </form>
    </div>
</section>

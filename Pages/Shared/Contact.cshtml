@page
@model ContactModel

@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">
    <h1>Contact Us</h1>
    <p class="lead">
        Have a question about Gifters or our disaster-relief efforts?
        Get in touch with us.
    </p>

    <div class="row mt-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3>Get in Touch</h3>

                    <p>
                        We welcome questions, suggestions, and enquiries
                        about donations and volunteering.
                    </p>

                    <p>
                        <strong>Email:</strong>
                        info@gifters.org
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        +27 67 536 1234
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3>Our Purpose</h3>

                    <p>
                        Gifters aims to connect people willing to help
                        with disaster-relief initiatives that need
                        support.
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>
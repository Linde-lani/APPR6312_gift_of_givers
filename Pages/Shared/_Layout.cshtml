@using System
@using Microsoft.AspNetCore.Mvc.RazorPages

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gifters</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-page="/Index">Gifters</a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    @{
                        // current page (Razor Pages route, e.g. "/Index" or "/Shared/Donate")
                        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
                        Func<string, string> activeClass = p => string.Equals(currentPage, p, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
                    }

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Index")"
                                   asp-page="/Index">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Shared/About")"
                                   asp-page="/Shared/About">About</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Shared/Donate")"
                                   asp-page="/Shared/Donate">Donate</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Shared/Volunteer")"
                                   asp-page="/Shared/Volunteer">Volunteer</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Shared/Contact")"
                                   asp-page="/Shared/Contact">Contact</a>
                            </li>

                            @if (User.IsInRole("Employee"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @activeClass("/Employee/Dashboard")"
                                       asp-page="/Employee/Dashboard">Employee</a>
                                </li>
                            }

                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">Logout</button>
                                </form>
                            </li>
                        }
                        else if (!string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Account/Login")"
                                   asp-page="/Account/Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @activeClass("/Account/Register")"
                                   asp-page="/Account/Register">Register</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>

    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="text-center py-4">
        <div class="container">
            <p>© @DateTime.Now.Year Gifters</p>
            <p>Supporting communities through disaster relief.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@page
@model Gifters.Pages.ProfileModel

@{
}
<section class="container my-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="list-group shadow-sm">
                <a href="/Profile" class="list-group-item list-group-item-action active">
                    <i class="bi bi-person-circle"></i> My Profile
                </a>
                <a href="/Profile/Donations" class="list-group-item list-group-item-action">
                    <i class="bi bi-heart-fill text-danger"></i> My Donations
                </a>
                <a href="/Profile/Events" class="list-group-item list-group-item-action">
                    <i class="bi bi-calendar-event"></i> My Events
                </a>
                <a href="/Profile/Volunteer" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i> Volunteer Activity
                </a>
                <a href="/Profile/Settings" class="list-group-item list-group-item-action">
                    <i class="bi bi-gear"></i> Settings
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            <h2 class="fw-bold mb-4 text-primary">My Profile</h2>

            <div class="card shadow-sm p-4 mb-4">
                <div class="row">
                    <!-- Profile Picture -->
                    <div class="col-md-4 text-center">
                        <img src="~/images/default-profile.png"
                             class="rounded-circle img-fluid mb-3"
                             alt="Profile Picture" style="width:150px; height:150px;">
                        <button class="btn btn-outline-primary btn-sm">Change Picture</button>
                    </div>

                    <!-- Profile Info -->
                    <div class="col-md-8">
                        <h4 class="fw-bold">Personal Information</h4>
                        <hr>
                        <dl class="row">
                            <dt class="col-sm-4">Full Name:</dt>
                            <dd class="col-sm-8">@Model.FullName</dd>

                            <dt class="col-sm-4">Email:</dt>
                            <dd class="col-sm-8">@Model.Email</dd>

                            <dt class="col-sm-4">Role:</dt>
                            <dd class="col-sm-8">@Model.Role</dd>

                            <dt class="col-sm-4">Joined:</dt>
                            <dd class="col-sm-8">@Model.JoinDate.ToShortDateString()</dd>
                        </dl>

          @*               <div class="mt-3">
                            <a href="/Profile/Edit" class="btn btn-primary">Edit Profile</a>
                            <a href="/Account/ChangePassword" class="btn btn-outline-secondary">Change Password</a>
                        </div>
                    </div>
                </div>
            </div> *@

            <!-- Activity Section -->
            <div class="card shadow-sm p-4">
                <h4 class="fw-bold">Recent Activity</h4>
                <hr>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Donation: R500 to Food Relief (12 Sep 2026)</li>
                    <li class="list-group-item">Volunteer Signup: Community Outreach (05 Sep 2026)</li>
                    <li class="list-group-item">Event Registration: Annual Charity Gala (20 Aug 2026)</li>
                </ul>
            </div>
        </div>
    </div>
</section>




